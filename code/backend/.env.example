
# -----------------------------------------------------------------------------
# Supabase PostgreSQL (production profile — the default, non-"dev" profile).
#
# IMPORTANT — pick the connection type that matches your network:
#
#  1) Direct connection (host: db.<project-ref>.supabase.co, port 5432) is
#     IPv6-ONLY. It fails on IPv4-only machines/networks with
#     "java.net.UnknownHostException" even though the host resolves, because the
#     only DNS record is an IPv6 (AAAA) address the machine cannot route to.
#
#  2) Session Pooler (IPv4-compatible) — use this if you are on IPv4 (most home
#     networks / Windows without IPv6). In the Supabase dashboard open
#     "Connect" -> "Session pooler" and copy the host/username it shows. It looks
#     like:   aws-0-<region>.pooler.supabase.com  on port 5432, and the username
#     becomes  postgres.<project-ref>  (NOT plain "postgres").
#
# Session Pooler example (fill in your real region / project-ref / password):
#   DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#   DB_USERNAME=postgres.<your-project-ref>
#
# Direct connection example (only works on IPv6-capable networks):
DB_URL=jdbc:postgresql://<your-supabase-host>:5432/<your-database>?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=your_supabase_db_password

JWT_SECRET=your_strong_random_jwt_secret_here

# Optional: email of an already-registered user to promote to ADMIN on startup.
# Leave blank for none. This is the safe, documented way to create the first admin
# (no hardcoded admin credentials exist). See README > Installation & Setup.
ADMIN_EMAIL=

