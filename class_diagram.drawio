        <mxCell id="sr_a" value="- id : Long&#10;- periodType : PeriodType&#10;- periodStart : LocalDate&#10;- periodEnd : LocalDate&#10;- periodLabel : String&#10;- targetAmount : Double&#10;- actualAmount : Double&#10;- createdAt : LocalDateTime&#10;- updatedAt : LocalDateTime" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="148" width="340" height="152" as="geometry" /></mxCell>
        <mxCell id="sr_m" value="+ SavingsRecord()&#10;+ getId() : Long&#10;+ getters / setters" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="300" width="340" height="58" as="geometry" /></mxCell>

        <!-- ===================== SideHustleBookmark ===================== -->
