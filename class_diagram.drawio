  </diagram>

  <diagram id="class-services" name="Class Diagram – Service &amp; Repository Layer">
    <mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t2" value="Class Diagram – MilestoneMetrics  (Service &amp; Repository Layer)" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=20;fontColor=#1F3864;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="900" height="26" as="geometry" /></mxCell>
        <mxCell id="t2s" value="Spring @Service classes depend on Spring Data repositories (constructor injection); every repository extends JpaRepository." style="text;html=1;align=left;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="42" y="40" width="1000" height="18" as="geometry" /></mxCell>

        <!-- ===== Services ===== -->
        <mxCell id="as_n" value="AuthService" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#333333;fontStyle=1;fontSize=13;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="80" width="360" height="28" as="geometry" /></mxCell>
        <mxCell id="as_a" value="- userRepository : UserRepository&#10;- passwordEncoder : PasswordEncoder&#10;- jwtUtil : JwtUtil" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="108" width="360" height="56" as="geometry" /></mxCell>
        <mxCell id="as_m" value="+ signup(request : SignupRequest) : void&#10;+ login(request : LoginRequest) : AuthResponse" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="164" width="360" height="40" as="geometry" /></mxCell>

        <mxCell id="fps_n" value="FinancialPlanService" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#333333;fontStyle=1;fontSize=13;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="256" width="380" height="28" as="geometry" /></mxCell>
        <mxCell id="fps_a" value="- planRepository : FinancialPlanRepository&#10;- userRepository : UserRepository" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="284" width="380" height="40" as="geometry" /></mxCell>
        <mxCell id="fps_m" value="+ savePlan(email : String, request : PlanRequest) : PlanResponse&#10;+ getPlan(email : String) : Optional&lt;PlanResponse&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="324" width="380" height="40" as="geometry" /></mxCell>

        <mxCell id="ss_n" value="SavingsService" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#333333;fontStyle=1;fontSize=13;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="416" width="420" height="28" as="geometry" /></mxCell>
        <mxCell id="ss_a" value="- savingsRepository : SavingsRecordRepository&#10;- planRepository : FinancialPlanRepository&#10;- userRepository : UserRepository" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="444" width="420" height="56" as="geometry" /></mxCell>
        <mxCell id="ss_m" value="+ saveSavings(email : String, request : SavingsRequest) : SavingsRecordResponse&#10;+ getProgress(email : String, periodType : PeriodType) : ProgressResponse" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="500" width="420" height="40" as="geometry" /></mxCell>

        <mxCell id="shs_n" value="SideHustleService" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#333333;fontStyle=1;fontSize=13;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="592" width="470" height="28" as="geometry" /></mxCell>
        <mxCell id="shs_a" value="- opportunityRepository : SideHustleOpportunityRepository&#10;- bookmarkRepository : SideHustleBookmarkRepository&#10;- planRepository : FinancialPlanRepository&#10;- userRepository : UserRepository" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="620" width="470" height="72" as="geometry" /></mxCell>
        <mxCell id="shs_m" value="+ getProfile(email : String) : SideHustleProfileResponse&#10;+ updateProfile(email : String, request : SideHustleProfileRequest) : SideHustleProfileResponse&#10;+ getRecommendations(email : String) : List&lt;RecommendationResponse&gt;&#10;+ addBookmark(email : String, opportunityId : Long) : void&#10;+ removeBookmark(email : String, opportunityId : Long) : void" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="692" width="470" height="88" as="geometry" /></mxCell>

        <!-- ===== Repositories (interfaces) ===== -->
        <mxCell id="ur_n" value="«interface»&#10;UserRepository" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#333333;fontStyle=1;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="700" y="70" width="360" height="40" as="geometry" /></mxCell>
        <mxCell id="ur_m" value="+ findByEmail(email : String) : Optional&lt;User&gt;&#10;+ existsByEmail(email : String) : boolean" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="110" width="360" height="40" as="geometry" /></mxCell>

        <mxCell id="fpr_n" value="«interface»&#10;FinancialPlanRepository" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#333333;fontStyle=1;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="700" y="188" width="360" height="40" as="geometry" /></mxCell>
