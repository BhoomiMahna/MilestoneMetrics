        <mxCell id="l_bk_op_r" value="bookmarks" style="text;html=1;fontSize=10;fontColor=#777777;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="980" y="486" width="90" height="16" as="geometry" /></mxCell>

        <!-- Enum usage dependencies -->
        <mxCell id="e_sr_pt" value="«use»" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=open;startArrow=none;dashed=1;strokeColor=#555555;strokeWidth=1.2;fontSize=10;fontColor=#555555;exitX=1;exitY=0.15;entryX=0;entryY=0.5;" edge="1" parent="1" source="sr_a" target="pt_n"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_op_df" value="«use»" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=open;startArrow=none;dashed=1;strokeColor=#555555;strokeWidth=1.2;fontSize=10;fontColor=#555555;exitX=1;exitY=0.42;entryX=0;entryY=0.5;" edge="1" parent="1" source="op_a" target="df_n"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ===================== Notes ===================== -->
        <mxCell id="note_user" value="A User owns exactly one FinancialPlan (0..1, unique per user)&#10;and many SavingsRecords and SideHustleBookmarks.&#10;Every owned record has a mandatory, non-null owning User." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="990" y="70" width="290" height="60" as="geometry" /></mxCell>
        <mxCell id="e_note_user" style="html=1;endArrow=none;dashed=1;strokeColor=#D6B656;" edge="1" parent="1" source="note_user" target="u_n"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="note_bk" value="A SideHustleBookmark links one User to one saved&#10;SideHustleOpportunity — unique per (user, opportunity).&#10;It references the opportunity but does not own it." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="560" y="620" width="330" height="60" as="geometry" /></mxCell>
        <mxCell id="e_note_bk" style="html=1;endArrow=none;dashed=1;strokeColor=#D6B656;" edge="1" parent="1" source="note_bk" target="bk_m"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="note_sr" value="One SavingsRecord per (user, periodType, periodStart);&#10;targetAmount is a snapshot of the plan target." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1080" y="378" width="320" height="46" as="geometry" /></mxCell>

        <!-- ===================== Legend ===================== -->
        <mxCell id="lg" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#FFFFFF;strokeColor=#666666;verticalAlign=top;fontStyle=1;fontSize=12;spacingTop=4;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="70" y="760" width="470" height="150" as="geometry" /></mxCell>
        <mxCell id="lg_assoc" style="html=1;endArrow=none;strokeColor=#333333;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="90" y="796" as="sourcePoint" /><mxPoint x="150" y="796" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="lg_assoc_t" value="Association (with multiplicity 1, 0..1, 0..*)" style="text;html=1;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="158" y="788" width="360" height="18" as="geometry" /></mxCell>
        <mxCell id="lg_comp" style="html=1;endArrow=none;startArrow=diamondThin;startFill=1;strokeColor=#333333;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="90" y="828" as="sourcePoint" /><mxPoint x="150" y="828" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="lg_comp_t" value="Composition — filled diamond at the owning class (User)" style="text;html=1;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="158" y="820" width="360" height="18" as="geometry" /></mxCell>
        <mxCell id="lg_dep" style="html=1;endArrow=open;dashed=1;strokeColor=#555555;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="90" y="860" as="sourcePoint" /><mxPoint x="150" y="860" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="lg_dep_t" value="Dependency «use» — dashed arrow (e.g. entity uses an enumeration)" style="text;html=1;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="158" y="852" width="380" height="18" as="geometry" /></mxCell>
        <mxCell id="lg_enum" value="«enumeration»" style="rounded=0;html=1;fillColor=#fff2cc;strokeColor=#333333;fontSize=10;" vertex="1" parent="1"><mxGeometry x="86" y="882" width="70" height="20" as="geometry" /></mxCell>
        <mxCell id="lg_enum_t" value="Enumeration type.  (Generalization / interface extension appears on page 2.)" style="text;html=1;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="162" y="882" width="380" height="18" as="geometry" /></mxCell>
