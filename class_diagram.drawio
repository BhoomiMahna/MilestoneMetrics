        <mxCell id="pt_b" value="WEEK&#10;MONTH&#10;YEAR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1500" y="190" width="150" height="56" as="geometry" /></mxCell>
        <mxCell id="df_n" value="«enumeration»&#10;Difficulty" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#333333;fontStyle=1;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="1500" y="480" width="190" height="40" as="geometry" /></mxCell>
        <mxCell id="df_b" value="BEGINNER&#10;INTERMEDIATE&#10;ADVANCED" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1500" y="520" width="190" height="56" as="geometry" /></mxCell>

        <!-- ===================== Associations (composition) ===================== -->
        <mxCell id="e_u_fp" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=none;startArrow=diamondThin;startFill=1;strokeColor=#333333;strokeWidth=1.4;" edge="1" parent="1" source="u_a" target="fp_n"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="240" y="150" /></Array></mxGeometry></mxCell>
