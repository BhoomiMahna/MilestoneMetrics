        <mxCell id="e_u_bk" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=none;startArrow=diamondThin;startFill=1;strokeColor=#333333;strokeWidth=1.4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="u_m" target="bk_n"><mxGeometry relative="1" as="geometry" /></mxCell>
