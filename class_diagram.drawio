<mxfile host="app.diagrams.net" agent="ClaudeCode" pages="2">
  <diagram id="class-domain" name="Class Diagram – Domain Model">
    <mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1020" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Class Diagram – MilestoneMetrics  (Domain Model)" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=20;fontColor=#1F3864;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="820" height="26" as="geometry" /></mxCell>
        <mxCell id="subtitle" value="Personalized Financial Goal-Achievement &amp; Income-Growth Platform — persistent entities and enumerations (from the Spring Boot JPA code)" style="text;html=1;align=left;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="42" y="40" width="900" height="18" as="geometry" /></mxCell>

        <!-- ===================== User ===================== -->
        <mxCell id="u_n" value="User" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#333333;fontStyle=1;fontSize=13;align=center;" vertex="1" parent="1"><mxGeometry x="650" y="70" width="300" height="28" as="geometry" /></mxCell>
        <mxCell id="u_a" value="- id : Long&#10;- name : String&#10;- email : String&#10;- password : String&#10;- createdAt : LocalDateTime" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="650" y="98" width="300" height="90" as="geometry" /></mxCell>
        <mxCell id="u_m" value="+ User()&#10;+ User(name : String, email : String, password : String)&#10;+ getId() : Long&#10;+ getters / setters" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="650" y="188" width="300" height="76" as="geometry" /></mxCell>

        <!-- ===================== FinancialPlan ===================== -->
        <mxCell id="fp_n" value="FinancialPlan" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#333333;fontStyle=1;fontSize=13;align=center;" vertex="1" parent="1"><mxGeometry x="70" y="360" width="340" height="28" as="geometry" /></mxCell>
        <mxCell id="fp_a" value="- id : Long&#10;- monthlyIncome : Double&#10;- monthlySpend : Double&#10;- currentInvestments : Double&#10;- ageBand : String&#10;- goalAmount : Double&#10;- timelineYears : Double&#10;- weeklyTarget : Double&#10;- monthlyTarget : Double&#10;- yearlyTarget : Double&#10;- skills : String&#10;- interests : String&#10;- availableHoursPerWeek : Integer&#10;- desiredMonthlyIncome : Double&#10;- createdAt : LocalDateTime&#10;- updatedAt : LocalDateTime" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="388" width="340" height="266" as="geometry" /></mxCell>
        <mxCell id="fp_m" value="+ FinancialPlan()&#10;+ getId() : Long&#10;+ getters / setters" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="654" width="340" height="58" as="geometry" /></mxCell>

        <!-- ===================== SavingsRecord ===================== -->
