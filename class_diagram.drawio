        <mxCell id="op_a" value="- id : Long&#10;- name : String&#10;- description : String&#10;- requiredSkills : String&#10;- interestTags : String&#10;- minMonthlyEarning : Double&#10;- maxMonthlyEarning : Double&#10;- minHoursPerWeek : Integer&#10;- maxHoursPerWeek : Integer&#10;- difficulty : Difficulty&#10;- online : Boolean&#10;- platformName : String&#10;- platformUrl : String" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="468" width="340" height="216" as="geometry" /></mxCell>
        <mxCell id="op_m" value="+ SideHustleOpportunity()&#10;+ getId() : Long&#10;+ getters / setters" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="684" width="340" height="58" as="geometry" /></mxCell>

        <!-- ===================== Enumerations ===================== -->
