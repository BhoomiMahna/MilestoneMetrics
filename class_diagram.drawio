        <mxCell id="bk_a" value="- id : Long&#10;- createdAt : LocalDateTime" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="620" y="468" width="340" height="40" as="geometry" /></mxCell>
        <mxCell id="bk_m" value="+ SideHustleBookmark()&#10;+ SideHustleBookmark(user : User, opportunity : SideHustleOpportunity)&#10;+ getId() : Long&#10;+ getters / setters" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="620" y="508" width="340" height="76" as="geometry" /></mxCell>

