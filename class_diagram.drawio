        <mxCell id="l_u_fp2" value="0..1" style="text;html=1;fontSize=11;fontColor=#102a43;" vertex="1" parent="1"><mxGeometry x="246" y="340" width="34" height="16" as="geometry" /></mxCell>

        <mxCell id="e_u_sr" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=none;startArrow=diamondThin;startFill=1;strokeColor=#333333;strokeWidth=1.4;exitX=1;exitY=0.4;entryX=0;entryY=0.5;" edge="1" parent="1" source="u_a" target="sr_a"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="l_u_sr1" value="1" style="text;html=1;fontSize=11;fontColor=#102a43;" vertex="1" parent="1"><mxGeometry x="956" y="150" width="24" height="16" as="geometry" /></mxCell>
